VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# VAPID key สำหรับ FCM Web Push — ได้จาก Firebase Console → Project Settings → Cloud Messaging → Web Push certificates → Generate key pair
VITE_FIREBASE_VAPID_KEY=

# ── Stripe (Frontend) ────────────────────────────
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY
VITE_STRIPE_SMALL_MONTHLY_PRICE_ID=price_...
VITE_STRIPE_SMALL_YEARLY_PRICE_ID=price_...
VITE_STRIPE_MEDIUM_MONTHLY_PRICE_ID=price_...
VITE_STRIPE_MEDIUM_YEARLY_PRICE_ID=price_...
VITE_STRIPE_LARGE_MONTHLY_PRICE_ID=price_...
VITE_STRIPE_LARGE_YEARLY_PRICE_ID=price_...

# ── LINE OA (Tenant invite link) ─────────────────────
# LINE OA ID จาก LINE Developers Console (เช่น @horcare)
VITE_LINE_OA_ID=@your_line_oa_id

# ── LINE Messaging API (Backend) ─────────────────────
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ── Firebase Admin Storage bucket (Backend, optional) ─
# ปล่อยว่างได้ จะ default เป็น <project_id>.firebasestorage.app
FIREBASE_STORAGE_BUCKET=

# ── Cron secret (Backend) ────────────────────────────
# ป้องกัน /api/prune-slips ให้เรียกได้เฉพาะ Vercel Cron — ตั้งเป็นสตริงสุ่มยาวๆ
# Vercel จะส่ง header: Authorization: Bearer <CRON_SECRET> ให้อัตโนมัติ
CRON_SECRET=

# ── Resend (Email delivery) ───────────────────────────
# สมัครฟรีที่ https://resend.com — 3,000 เมล/เดือน
# แนะนำตั้งค่า Custom Domain เพื่อให้เมลเข้ากล่องหลัก (ไม่ตกสแปม)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# ถ้าไม่มี custom domain ใช้ onboarding@resend.dev ได้ (จำกัดส่งแค่ owner email)
EMAIL_FROM=noreply@yourdomain.com
