VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# VAPID key สำหรับ FCM Web Push — ได้จาก Firebase Console → Project Settings → Cloud Messaging → Web Push certificates → Generate key pair
VITE_FIREBASE_VAPID_KEY=

# ── Stripe (Frontend) ────────────────────────────
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY
VITE_STRIPE_SMALL_MONTHLY_PRICE_ID=price_...
VITE_STRIPE_SMALL_YEARLY_PRICE_ID=price_...
VITE_STRIPE_MEDIUM_MONTHLY_PRICE_ID=price_...
VITE_STRIPE_MEDIUM_YEARLY_PRICE_ID=price_...
VITE_STRIPE_LARGE_MONTHLY_PRICE_ID=price_...
VITE_STRIPE_LARGE_YEARLY_PRICE_ID=price_...

# ── LINE OA (Tenant invite link) ─────────────────────
# LINE OA ID จาก LINE Developers Console (เช่น @horcare)
VITE_LINE_OA_ID=@your_line_oa_id

# ── LINE Messaging API (Backend) ─────────────────────
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ── Firebase Admin Storage bucket (Backend, optional) ─
# ปล่อยว่างได้ จะ default เป็น <project_id>.firebasestorage.app
FIREBASE_STORAGE_BUCKET=

# ── Cron secret (Backend) ────────────────────────────
# ป้องกัน /api/prune-slips ให้เรียกได้เฉพาะ Vercel Cron — ตั้งเป็นสตริงสุ่มยาวๆ
# Vercel จะส่ง header: Authorization: Bearer <CRON_SECRET> ให้อัตโนมัติ
CRON_SECRET=

# ── Resend (Email delivery) ───────────────────────────
# สมัครฟรีที่ https://resend.com — 3,000 เมล/เดือน
# แนะนำตั้งค่า Custom Domain เพื่อให้เมลเข้ากล่องหลัก (ไม่ตกสแปม)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# ถ้าไม่มี custom domain ใช้ onboarding@resend.dev ได้ (จำกัดส่งแค่ owner email)
EMAIL_FROM=noreply@yourdomain.com

# ── Gemini (Meter Reading OCR) ─────────────────────
GEMINI_API_KEY=

# ── LINE OA for STAFF (technician / housekeeping) — a separate Official Account ──
# Frontend: the staff OA id, used to build the "connect my LINE" deep link (e.g. @797mjkoe)
VITE_LINE_STAFF_OA_ID=
# Backend: channel credentials of the staff OA (LINE Developers Console → Messaging API).
# Webhook URL to set on that channel: https://<your-domain>/api/line-staff-webhook
LINE_STAFF_CHANNEL_ACCESS_TOKEN=
LINE_STAFF_CHANNEL_SECRET=

# ── AI provider (meter reading, slip amounts, Nong Care) ──
# Set OPENROUTER_API_KEY to use OpenRouter; otherwise the app falls back to GEMINI_API_KEY above.
# AI_PROVIDER=openrouter|gemini forces one when both keys exist (handy for switching back).
OPENROUTER_API_KEY=
# Optional model overrides (OpenRouter model ids). Vision models must accept images.
# Defaults: vision = google/gemini-2.5-flash-lite, text = google/gemini-2.5-flash
OPENROUTER_VISION_MODEL=
OPENROUTER_TEXT_MODEL=
AI_PROVIDER=

# ── Local development environments (NFR-10) — put these in .env.local ──
# `npm run dev` refuses to start against the production Firebase project. Pick one:
#   • a staging Firebase project: fill the VITE_FIREBASE_* values above with its config
#   • local emulators: run `npm run emulators` in another terminal and set
VITE_FIREBASE_EMULATORS=
#   • production on purpose (live data!): VITE_ALLOW_PRODUCTION_IN_DEV=true
VITE_ALLOW_PRODUCTION_IN_DEV=
# Where /api goes in `npm run dev`. Empty = http://localhost:3000 (`vercel dev`); never production by default.
API_PROXY_TARGET=

# ── Tenant portal / housekeepers / cron (server) ──
# LINE Login channel of the LIFF app (number before the dash in the LIFF id); verifies portal sign-ins from LINE
LINE_LOGIN_CHANNEL_ID=
VITE_LIFF_ID=
# Transitional: verifies the older signed portal links (?uid=&bid=&rid=&t=) already sent to tenants.
# If unset, LINE_CHANNEL_SECRET is used. Changing it ends all of those older links at once.
PORTAL_LINK_SECRET=
