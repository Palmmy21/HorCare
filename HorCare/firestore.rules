rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'sakdidechneverdie@gmail.com' ||
        request.auth.token.email == 'horcare.admin@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isNotBanned() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') != 'banned';
    }

    // ── License enforcement (server-side) ────────────────────────────────
    // Block data WRITES once the plan lapses so limits can't be bypassed by
    // hitting Firestore directly (outside the app UI). Reads stay open so an
    // expired user never loses access to their own data.
    //   • 'active'            → lifetime, always allowed
    //   • 'free'              → permanent free plan (access_until == 0)
    //   • access_until == 0   → free plan or legacy doc → grace (allow)
    //   • access_until > now  → still within the paid period
    function licenseActive(userId) {
      let u = get(/databases/$(database)/documents/users/$(userId)).data;
      let au = u.get('access_until', 0);
      return u.get('license', 'free') == 'active'
             || au == 0
             || au > request.time.toMillis();
    }

    // ── RBAC (members) ───────────────────────────────────────────────────
    // Staff access is granted by the owner through the /api/members route
    // (Admin SDK). Documents live at users/{ownerId}/members/{memberUid} and carry
    // a denormalised `permissions` array written by the backend from the role map
    // in src/shared/permissions.ts. Clients can never write them.
    function activeMember(ownerId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(ownerId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(ownerId)/members/$(request.auth.uid)).data.status == 'active';
    }

    function memberHasPerm(ownerId, perm) {
      return activeMember(ownerId)
        && perm in get(/databases/$(database)/documents/users/$(ownerId)/members/$(request.auth.uid)).data.permissions;
    }

    // Same, but also requires the member to have been granted this property
    // (multi-property isolation). property_ids may contain '*' for all properties.
    function memberHasPermOn(ownerId, buildingId, perm) {
      return memberHasPerm(ownerId, perm)
        && get(/databases/$(database)/documents/users/$(ownerId)/members/$(request.auth.uid)).data.property_ids.hasAny(['*', buildingId]);
    }

    // Granted every property ('*')? Such a member is an organisation-wide administrator.
    function memberAll(ownerId) {
      return activeMember(ownerId)
        && get(/databases/$(database)/documents/users/$(ownerId)/members/$(request.auth.uid)).data.property_ids.hasAny(['*']);
    }

    // True when the member may see every property in `ids` (all of them, or '*'). Used for documents that span
    // properties (ledgers): a member of building A must never see a ledger that also covers building B.
    function memberCoversAll(ownerId, ids) {
      return activeMember(ownerId)
        && (memberAll(ownerId)
            || ids.hasOnly(get(/databases/$(database)/documents/users/$(ownerId)/members/$(request.auth.uid)).data.property_ids));
    }

    // May this member change data of THIS property? Needs the permission, the property grant and the
    // organisation's licence (the same condition the owner's own writes need).
    function memberCan(ownerId, buildingId, perm) {
      return memberHasPermOn(ownerId, buildingId, perm) && licenseActive(ownerId);
    }

    // An active member who was granted THIS property (or every property). Used for reading a property's
    // everyday data; anything sensitive (tenant profiles, finance, messages …) needs its own permission.
    function memberOn(ownerId, buildingId) {
      return activeMember(ownerId)
        && get(/databases/$(database)/documents/users/$(ownerId)/members/$(request.auth.uid)).data.property_ids.hasAny(['*', buildingId]);
    }

    // The owner changing their own data (same condition everywhere).
    function ownerWrites(userId) {
      return isOwner(userId) && isNotBanned() && licenseActive(userId);
    }

    // ── Housekeepers (แม่บ้าน) ────────────────────────────────────────────
    // They sign in through /api/housekeepers, which checks the passcode server-side and issues a custom token with
    // claims hk_owner / hk_building / hk_maid / hk_ver. The token counts only while that housekeeper record is active
    // and its session_version is still hk_ver: changing the passcode or switching the account off ends every session.
    function isHousekeeper(ownerId, buildingId) {
      return isSignedIn()
        && request.auth.token.get('hk_owner', '') == ownerId
        && request.auth.token.get('hk_building', '') == buildingId
        && request.auth.token.get('hk_maid', '') != ''
        && exists(/databases/$(database)/documents/users/$(ownerId)/buildings/$(buildingId)/housekeepers/$(request.auth.token.hk_maid))
        && get(/databases/$(database)/documents/users/$(ownerId)/buildings/$(buildingId)/housekeepers/$(request.auth.token.hk_maid)).data.get('is_active', true) != false
        && get(/databases/$(database)/documents/users/$(ownerId)/buildings/$(buildingId)/housekeepers/$(request.auth.token.hk_maid)).data.get('session_version', 0) == request.auth.token.get('hk_ver', -1);
    }

    function housekeeperWrites(ownerId, buildingId) {
      return isHousekeeper(ownerId, buildingId) && licenseActive(ownerId);
    }

    // ── Field-level limits for updates ───────────────────────────────────
    function changesOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // A bill's readings and the amounts computed from them (meter recording).
    function billMeterFields() {
      return ['id', 'room_id', 'room_number', 'month', 'prev_elec', 'curr_elec', 'elec_units', 'elec_bill',
              'prev_water', 'curr_water', 'water_units', 'water_bill', 'water_flat_amount', 'water_excess_units',
              'water_excess_amount', 'common_fee', 'applied_common_fees', 'room_rent', 'rent_prorate', 'total_bill', 'tenant_count',
              'is_saved', 'is_notified', 'created_at', 'updated_at'];
    }

    // How a bill was paid (payment recording).
    function billPaymentFields() {
      return ['payment_status', 'payment_method', 'paid_at', 'paid_method', 'paid_amount', 'received_by',
              'bank_account', 'bank_account_id', 'transaction_ref', 'verification_status', 'payment_note',
              'payment_date', 'updated_at'];
    }

    // A closed month's bill: its amounts are what went to the tenant and into the books.
    function billLocked() {
      return resource.data.get('is_locked', false) == true;
    }

    // Fields only the backend (or admin) should write — never the user directly (updates only)
    function isWritingProtectedFields() {
      let protectedFields = ['license', 'subscription_id', 'subscription_status',
                             'current_period_end', 'access_until', 'plan_name', 'billing_cycle',
                             'stripe_customer_id', 'trial_expires_at', 'trial_started_at', 'trial_until', 'role', 'status'];
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedFields);
    }

    // On CREATE: allow license='free' and access_until=0 (initial signup defaults),
    // but block any billing/subscription fields that only the backend should set.
    function isWritingProtectedFieldsOnCreate() {
      let billingFields = ['subscription_id', 'subscription_status', 'current_period_end',
                           'plan_name', 'billing_cycle', 'stripe_customer_id', 'trial_expires_at', 'trial_started_at', 'trial_until',
                           'role', 'status'];
      let hasBillingField = request.resource.data.keys().hasAny(billingFields);
      let licenseOk = request.resource.data.get('license', 'free') == 'free';
      let accessUntilOk = request.resource.data.get('access_until', 0) == 0;
      return hasBillingField || !licenseOk || !accessUntilOk;
    }

    // ── User Profile ─────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // User can write their own profile, but NOT protected subscription/license fields
      allow write: if isAdmin();
      allow update: if isOwner(userId) && !isWritingProtectedFields() && isNotBanned();
      allow create: if isOwner(userId) && !isWritingProtectedFieldsOnCreate();

      // ── Buildings ───────────────────────────────────────────────────────
      // read: any non-banned owner. write: also requires a non-expired license.
      // Nothing below is public. Tenants reach their own room only through /api/portal (the portal link is checked
      // server-side); housekeepers through a custom token limited to their building (isHousekeeper).
      match /buildings/{buildingId} {
        // Any active member may list the organisation's buildings (names only — the app's building picker); a
        // housekeeper may read their own building.
        allow read: if (isOwner(userId) && isNotBanned()) || activeMember(userId) || isHousekeeper(userId, buildingId);
        allow write: if isOwner(userId) && isNotBanned() && licenseActive(userId);

        // Staff may change a property's data only with the matching permission ON THAT PROPERTY (memberCan);
        // creating, renaming or deleting properties stays with the owner.
        match /rooms/{roomId} {
          allow read: if (isOwner(userId) && isNotBanned()) || memberOn(userId, buildingId) || isHousekeeper(userId, buildingId);
          allow create: if ownerWrites(userId) || memberCan(userId, buildingId, 'room.create');
          // meter recording may only move the room's current readings
          allow update: if ownerWrites(userId) || memberCan(userId, buildingId, 'room.update')
                        || ((memberCan(userId, buildingId, 'meter.record') || housekeeperWrites(userId, buildingId))
                            && changesOnly(['current_meter_elec', 'current_meter_water']));
          allow delete: if ownerWrites(userId) || memberCan(userId, buildingId, 'room.delete');
        }
        // Parking spaces: staff who may edit rooms manage them (assigning a spot also updates the room's parking copy).
        match /parking_spots/{spotId} {
          allow read: if (isOwner(userId) && isNotBanned()) || memberOn(userId, buildingId);
          allow write: if ownerWrites(userId) || memberCan(userId, buildingId, 'room.update');
        }
        match /bills/{billId} {
          allow read: if (isOwner(userId) && isNotBanned()) || memberOn(userId, buildingId) || isHousekeeper(userId, buildingId);
          // Meter recording opens the month's bill: readings and amounts only, not locked, no payment.
          allow create: if ownerWrites(userId)
                        || ((memberCan(userId, buildingId, 'meter.record') || housekeeperWrites(userId, buildingId))
                            && request.resource.data.keys().hasOnly(billMeterFields().concat(['is_locked']))
                            && request.resource.data.get('is_locked', false) == false);
          allow update: if
            // the owner — but a closed bill keeps its amounts: it can still take a payment, be reminded or be reopened
            (ownerWrites(userId)
              && (!billLocked() || changesOnly(billPaymentFields().concat(['is_locked', 'is_notified', 'last_reminded_at', 'reminder_count']))))
            // meter recording: readings and the amounts computed from them, on an open bill only
            || ((memberCan(userId, buildingId, 'meter.record') || housekeeperWrites(userId, buildingId))
                && !billLocked() && changesOnly(billMeterFields()))
            // payment.update may change how a bill was paid (including undoing it)
            || (memberCan(userId, buildingId, 'payment.update') && changesOnly(billPaymentFields()))
            // payment.create may only record a payment on a bill that is not paid yet
            || (memberCan(userId, buildingId, 'payment.create') && changesOnly(billPaymentFields())
                && resource.data.get('payment_status', 'unpaid') != 'paid')
            // closing / reopening a month
            || (memberCan(userId, buildingId, 'property.update') && changesOnly(['is_locked', 'updated_at']));
          allow delete: if ownerWrites(userId) && !billLocked();
        }
        match /data/{docId} {
          // the property's settings (rates, bill layout) — needed by everyone who records meters or bills
          allow read: if (isOwner(userId) && isNotBanned()) || memberOn(userId, buildingId) || isHousekeeper(userId, buildingId);
          allow write: if ownerWrites(userId) || memberCan(userId, buildingId, 'property.update');
        }
        // Tenant profiles hold personal data (phone, ID-card number, emergency contact): tenant.read only.
        match /tenants/{roomId} {
          allow read: if (isOwner(userId) && isNotBanned()) || memberHasPermOn(userId, buildingId, 'tenant.read');
          allow write: if ownerWrites(userId) || memberCan(userId, buildingId, 'tenant.update');

          // Tenancy history (move in/out, contract signed …). Entries are never edited; only the owner may remove one.
          match /events/{eventId} {
            allow read: if (isOwner(userId) && isNotBanned()) || memberHasPermOn(userId, buildingId, 'tenant.read');
            allow create: if (isOwner(userId) && isNotBanned() && licenseActive(userId)) || memberCan(userId, buildingId, 'tenant.update');
            allow update: if false;
            allow delete: if isOwner(userId) && isNotBanned();
          }
        }
        // Slip images stored as base64 by the LINE webhook (Admin SDK bypasses rules).
        // Owner may read to view slips on the web; clients may not write.
        match /slip_images/{slipId} {
          allow read: if (isOwner(userId) && isNotBanned()) || memberHasPermOn(userId, buildingId, 'finance.read');
          allow write: if false; // backend only via admin SDK
        }

        // ── Maintenance requests (แจ้งซ่อม) ─────────────────────────────
        // Tenants report through /api/portal (validated, filed under their own room); staff handle them here.
        match /maintenance/{reqId} {
          allow read: if (isOwner(userId) && isNotBanned()) || memberOn(userId, buildingId);
          allow update, delete: if (isOwner(userId) && isNotBanned()) || memberHasPermOn(userId, buildingId, 'work_order.update');
          allow create: if false;
        }

        // ── Cleaning requests (งานทำความสะอาด/แม่บ้าน) ────────────────────
        // Tenants request through /api/portal. The owner and staff manage them; a housekeeper may only accept and
        // complete jobs that are open or assigned to them.
        match /cleaning/{reqId} {
          allow read: if (isOwner(userId) && isNotBanned()) || memberOn(userId, buildingId) || isHousekeeper(userId, buildingId);
          allow create: if ownerWrites(userId) || memberCan(userId, buildingId, 'work_order.update') || memberCan(userId, buildingId, 'property.update');
          allow update: if ownerWrites(userId) || memberCan(userId, buildingId, 'work_order.update') || memberCan(userId, buildingId, 'property.update')
                        || (housekeeperWrites(userId, buildingId)
                            && changesOnly(['status', 'accepted_at', 'assigned_maid_id', 'assigned_maid_name', 'assigned_maid_phone',
                                            'completed_at', 'completed_by', 'completion_notes', 'completed_note', 'updated_at'])
                            && request.resource.data.status in ['in_progress', 'completed']
                            && resource.data.get('assigned_maid_id', request.auth.token.hk_maid) == request.auth.token.hk_maid
                            && request.resource.data.get('assigned_maid_id', request.auth.token.hk_maid) == request.auth.token.hk_maid
                            && request.resource.data.get('completed_by', 'maid') == 'maid');
          allow delete: if (isOwner(userId) && isNotBanned()) || memberHasPermOn(userId, buildingId, 'property.update');
        }

        // ── Cleaning photos (older requests kept the photo here) ─────────
        match /cleaning_images/{reqId} {
          allow read: if (isOwner(userId) && isNotBanned()) || memberOn(userId, buildingId) || isHousekeeper(userId, buildingId);
          allow write: if ownerWrites(userId) || memberCan(userId, buildingId, 'property.update');
        }

        // ── Housekeepers (แม่บ้าน) ───────────────────────────────────────
        // Written only by /api/housekeepers (passcodes are hashed there and never stored on these records).
        match /housekeepers/{maidId} {
          allow read: if (isOwner(userId) && isNotBanned()) || memberOn(userId, buildingId)
                      || (isHousekeeper(userId, buildingId) && request.auth.token.hk_maid == maidId);
          allow write: if false;
        }

        // ── Operations collections (the owner, or staff allowed to manage THIS property) ──────────────────────────
        match /vendors/{docId} {
          allow read, write: if (isOwner(userId) && isNotBanned()) || memberHasPermOn(userId, buildingId, 'property.update');
        }
        match /stock/{docId} {
          allow read, write: if (isOwner(userId) && isNotBanned()) || memberHasPermOn(userId, buildingId, 'property.update');
        }
        match /assets/{docId} {
          allow read, write: if (isOwner(userId) && isNotBanned()) || memberHasPermOn(userId, buildingId, 'property.update');
        }
        match /expenses/{docId} {
          allow read, write: if (isOwner(userId) && isNotBanned()) || memberHasPermOn(userId, buildingId, 'property.update');
        }
        // ── ค่าปรับ (tenants see their own through /api/portal) ─────────────
        match /fines/{docId} {
          allow read: if (isOwner(userId) && isNotBanned()) || memberOn(userId, buildingId);
          allow write: if (isOwner(userId) && isNotBanned()) || memberHasPermOn(userId, buildingId, 'property.update');
        }
        // ── ค่าบริการส่วนกลาง — read by whoever computes bills (meter recording) ──
        match /common_fees/{docId} {
          allow read: if (isOwner(userId) && isNotBanned()) || memberOn(userId, buildingId) || isHousekeeper(userId, buildingId);
          allow write: if (isOwner(userId) && isNotBanned()) || memberHasPermOn(userId, buildingId, 'property.update');
        }

        // ── Parcels — written only by /api/parcels (permission checks, audit, notifications).
        // Staff with parcel.read on THIS property may read; tenants use the API's minimal view.
        match /parcels/{parcelId} {
          allow read: if (isOwner(userId) && isNotBanned()) || memberHasPermOn(userId, buildingId, 'parcel.read');
          allow write: if false;
        }
        match /parcel_images/{parcelId} {
          allow read: if (isOwner(userId) && isNotBanned()) || memberHasPermOn(userId, buildingId, 'parcel.read');
          allow write: if false;
        }
        // ── Work orders, their photos and the staff directory — written only by /api/work-orders
        // (permission checks, audit, LINE notification). Staff themselves use a per-job link
        // through that API and never touch Firestore.
        match /work_orders/{orderId} {
          allow read: if (isOwner(userId) && isNotBanned()) || memberHasPermOn(userId, buildingId, 'work_order.read');
          allow write: if false;
        }
        match /work_order_images/{imageId} {
          allow read: if (isOwner(userId) && isNotBanned()) || memberHasPermOn(userId, buildingId, 'work_order.read');
          allow write: if false;
        }
        match /staff/{staffId} {
          allow read: if (isOwner(userId) && isNotBanned()) || memberHasPermOn(userId, buildingId, 'work_order.read');
          allow write: if false;
        }
        // ── LINE inbox: tenant conversations. Written by the LINE webhook and /api/line-inbox only.
        // Reading needs message.read on THIS property.
        match /shop_closures/{closureId} {
          allow read: if (isOwner(userId) && isNotBanned()) || memberHasPermOn(userId, buildingId, 'shop.read');
          allow write: if false;
        }
        match /walk_ins/{walkInId} {
          allow read: if (isOwner(userId) && isNotBanned()) || memberHasPermOn(userId, buildingId, 'visitor.read');
          allow write: if false;
        }
        match /security_alerts/{alertId} {
          allow read: if (isOwner(userId) && isNotBanned()) || memberHasPermOn(userId, buildingId, 'audit_log.read');
          allow write: if false;
        }
        match /payments/{paymentId} {
          allow read: if (isOwner(userId) && isNotBanned()) || memberHasPermOn(userId, buildingId, 'finance.read');
          allow write: if false;
        }
        match /faqs/{faqId} {
          allow read: if (isOwner(userId) && isNotBanned()) || memberHasPermOn(userId, buildingId, 'chatbot.manage');
          allow write: if false;
        }
        match /announcements/{announcementId} {
          allow read: if (isOwner(userId) && isNotBanned()) || memberHasPermOn(userId, buildingId, 'announcement.manage');
          allow write: if false;
        }
        match /line_threads/{lineUserId} {
          allow read: if (isOwner(userId) && isNotBanned()) || memberHasPermOn(userId, buildingId, 'message.read');
          allow write: if false;

          match /messages/{messageId} {
            allow read: if (isOwner(userId) && isNotBanned()) || memberHasPermOn(userId, buildingId, 'message.read');
            allow write: if false;
          }
        }
        // ── Bank accounts the property receives money into — written only by /api/bank-accounts.
        // Readable by the owner and by members with finance.read on THIS property.
        match /bank_accounts/{accountId} {
          allow read: if (isOwner(userId) && isNotBanned()) || memberHasPermOn(userId, buildingId, 'finance.read');
          allow write: if false;
        }
        // Bank statement lines + their reconciliation state. Written only by /api/reconciliation.
        match /bank_transactions/{txId} {
          allow read: if (isOwner(userId) && isNotBanned()) || memberHasPermOn(userId, buildingId, 'finance.read');
          allow write: if false;
        }
        // Payment-gateway intents (QR / pay link per bill) — written only by /api/payment-gateway and the provider webhook.
        match /payment_intents/{intentId} {
          allow read: if (isOwner(userId) && isNotBanned()) || memberHasPermOn(userId, buildingId, 'finance.read');
          allow write: if false;
        }
        // In-app notification records produced by the central notification service.
        match /notifications/{notificationId} {
          allow read: if (isOwner(userId) && isNotBanned()) || memberHasPermOn(userId, buildingId, 'room.read');
          allow write: if false;
        }
      }

      // ── Members (RBAC) — read-only for clients; managed via /api/members ──
      match /members/{memberId} {
        // everyone sees their own record; the full list only goes to the owner and organisation-wide administrators
        allow read: if isOwner(userId)
                    || (isSignedIn() && request.auth.uid == memberId)
                    || (memberHasPerm(userId, 'member.read') && memberAll(userId));
        allow write: if false;
      }

      // ── Activity log — append-only. Nobody (owner included) can edit or delete. ──
      // HorCare's own books: written only by /api/ledger. Entries are never edited or deleted.
      match /ledgers/{ledgerId} {
        // a ledger can cover several properties: staff see it only if they may see every one of them
        allow read: if (isOwner(userId) && isNotBanned()) || (memberHasPerm(userId, 'ledger.read') && memberCoversAll(userId, resource.data.property_ids));
        allow write: if false;
        match /entries/{entryId} {
          allow read: if (isOwner(userId) && isNotBanned())
            || (memberHasPerm(userId, 'ledger.read')
                && memberCoversAll(userId, get(/databases/$(database)/documents/users/$(userId)/ledgers/$(ledgerId)).data.property_ids));
          allow write: if false;
        }
      }
      // Accounting export profiles + batches: written only by /api/accounting.
      match /accounting_profiles/{profileId} {
        allow read: if (isOwner(userId) && isNotBanned()) || (memberHasPerm(userId, 'accounting.export') && memberAll(userId));
        allow write: if false;
      }
      match /accounting_batches/{batchId} {
        allow read: if (isOwner(userId) && isNotBanned()) || (memberHasPerm(userId, 'accounting.export') && memberAll(userId));
        allow write: if false;
        match /items/{itemId} {
          allow read: if (isOwner(userId) && isNotBanned()) || (memberHasPerm(userId, 'accounting.export') && memberAll(userId));
          allow write: if false;
        }
      }
      match /audit_logs/{eventId} {
        // the activity log spans every property, so only organisation-wide administrators may read it
        allow read: if (isOwner(userId) && isNotBanned()) || (memberHasPerm(userId, 'audit_log.read') && memberAll(userId));
        allow create: if isNotBanned()
          && request.resource.data.event_id == eventId
          && request.resource.data.organization_id == userId
          && request.resource.data.user_id == request.auth.uid
          && request.resource.data.action is string
          && request.resource.data.resource_type is string
          && ((isOwner(userId) && request.resource.data.role == 'owner')
              || (activeMember(userId)
                  && request.resource.data.role == get(/databases/$(database)/documents/users/$(userId)/members/$(request.auth.uid)).data.role));
        allow update, delete: if false;
      }

      // ── Legacy flat paths ──────────────────────────────────────────────
      match /rooms/{roomId} {
        allow read: if isOwner(userId) && isNotBanned();
        allow write: if isOwner(userId) && isNotBanned() && licenseActive(userId);
      }
      match /bills/{billId} {
        allow read: if isOwner(userId) && isNotBanned();
        allow write: if isOwner(userId) && isNotBanned() && licenseActive(userId);
      }
      match /data/{docId} {
        allow read: if isOwner(userId) && isNotBanned();
        allow write: if isOwner(userId) && isNotBanned() && licenseActive(userId);
      }
      // Excludes audit_logs/members: those have their own (stricter) rules above and
      // a permissive wildcard here would let the owner rewrite history.
      match /{subCol}/{docId} {
        allow read: if isOwner(userId) && isNotBanned() && subCol != 'audit_logs' && subCol != 'members'
                     && subCol != 'accounting_profiles' && subCol != 'accounting_batches' && subCol != 'ledgers';
        allow write: if isOwner(userId) && isNotBanned() && licenseActive(userId)
                     && subCol != 'audit_logs' && subCol != 'members'
                     && subCol != 'accounting_profiles' && subCol != 'accounting_batches' && subCol != 'ledgers';
      }
    }

    // ── LINE registration tables (written by backend API only) ───────────
    // No client-side access — backend writes via Service Account (bypasses rules)
    match /line_rooms/{lineUserId} {
      allow read: if isAdmin();
      allow write: if false; // backend only via admin SDK
    }
    match /line_pending/{lineUserId} {
      allow read: if isAdmin();
      allow write: if false; // backend only via admin SDK
    }

    // ── Dorm codes (readable by backend, writable by owner or admin) ────
    // เจ้าของหอสามารถสร้าง/อัปเดตรหัสหอของตัวเองได้
    // ต้องมี uid field ตรงกับ auth.uid เพื่อกันการเขียนทับรหัสของคนอื่น
    match /dorm_codes/{code} {
      allow read: if false;  // backend only
      allow write: if isAdmin()
        || (isSignedIn() && isNotBanned()
            && request.resource.data.uid == request.auth.uid
            && (!exists(/databases/$(database)/documents/dorm_codes/$(code)) || get(/databases/$(database)/documents/dorm_codes/$(code)).data.uid == request.auth.uid));
    }

    // ── Housekeeper sign-in records (phone → building + passcode hash) ──
    // Server-only: /api/housekeepers checks passcodes and manages these. No client may read or write them.
    match /housekeepers_auth/{phone} {
      allow read, write: if false;
    }

    // ── Deny all other paths ─────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
